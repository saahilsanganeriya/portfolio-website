---
import { readFileSync, statSync } from 'node:fs';
import MonitorFrame from '../components/MonitorFrame.astro';
import RecordCrate from '../components/RecordCrate.astro';
import RoomHud from '../components/RoomHud.astro';
import RoomLoader from '../components/RoomLoader.astro';
import RoomTour from '../components/RoomTour.astro';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** The SaahilOS window this address opens on the monitor (`projects/swe-sim`, `about`); none on `/`. */
  open?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description, open = '', ogType, publishedTime } = Astro.props;
// The loading screen is the void the room floats in, so the room fades in out of the same colour.
const { voidColor: planVoid } = JSON.parse(readFileSync('public/room/floorplan.json', 'utf8')) as { voidColor?: unknown };
const voidColor = typeof planVoid === 'string' && /^#[0-9a-f]{6}$/i.test(planVoid) ? planVoid : undefined;
// room.glb's size: the loading line counts its bytes when the server sends it compressed, without a length.
const roomBytes = statSync('public/room/room.glb').size;
---

<Base {title} {description} {ogType} {publishedTime} bare skipLabel="Open SaahilOS">
  {/*
    Every page of the site is this one room. The head script picks how it is shown before anything renders: the 3D
    room on a desktop with WebGL; on phones, touch-first or small screens the same room at a light tier, which goes
    into the monitor and hands over to SaahilOS on the drawn monitor; the drawn monitor alone for Save-Data, little
    memory and browsers without WebGL. Without JavaScript the drawn monitor shows and says why it is dark.
  */}
  <script is:inline slot="head">
    (function () {
      // A page of the site followed inside the monitor takes the whole tab, so the room never runs inside itself.
      if (window.top !== window.self) {
        try {
          window.top.location.href = location.href;
        } catch (e) {}
        return;
      }
      var root = document.documentElement;
      var media = function (q) { return window.matchMedia && window.matchMedia(q).matches; };
      var saveData = (navigator.connection && navigator.connection.saveData) || media('(prefers-reduced-data: reduce)');
      // Chrome reports the device's memory in GB (rounded, at most 8); under 2 GB the room does not fit beside the OS.
      var memory = navigator.deviceMemory;
      var flat = saveData || (typeof memory === 'number' && memory < 2);
      if (!flat) {
        var gl = null;
        try {
          var canvas = document.createElement('canvas');
          gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
        } catch (e) {}
        if (gl) {
          var lose = gl.getExtension('WEBGL_lose_context');
          if (lose) lose.loseContext();
        }
        flat = !gl;
      }
      if (flat) root.classList.add('room-2d');
      else {
        root.classList.add('room');
        if (media('(pointer: coarse)') || media('(max-width: 767.98px)')) root.classList.add('room-light');
        if (media('(prefers-reduced-motion: reduce)')) root.classList.add('room-reduced', 'room-paused');
      }
    })();
  </script>

  <main id="content" class="room-stage" tabindex="-1" aria-label="The room" data-room data-open={open} data-room-bytes={roomBytes} style={voidColor && `--room-void: ${voidColor}`}>
    <h1 class="visually-hidden">{title}</h1>
    <RoomHud />
    <RoomTour />
    <RecordCrate />
    <div class="room-world" data-room-world></div>
    <RoomLoader />
    <MonitorFrame />
    <div class="room-controls">
      <button type="button" class="room-sound" aria-pressed="false" data-room-sound>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path class="room-sound-speaker" d="M2 6h3l4-3v10l-4-3H2z"></path>
          <path class="room-sound-on" d="M11 5.6a3.4 3.4 0 0 1 0 4.8M12.9 3.8a6 6 0 0 1 0 8.4"></path>
          <path class="room-sound-off" d="M11 6l4 4M15 6l-4 4"></path>
        </svg>
        Sound
      </button>
      <label class="room-volume">
        <span class="visually-hidden">Volume</span>
        <input type="range" min="0" max="100" step="5" value="100" data-room-volume />
      </label>
      <button type="button" aria-pressed="false" data-room-pause>Pause motion</button>
    </div>
    <p class="visually-hidden" role="status" data-room-status></p>
  </main>
</Base>

<script>
  import { mountHud } from '../components/RoomHud';
  import { loadFloorPlan, mountTour } from '../components/RoomTourMap';
  import { mountSoundControls } from '../scene/audio/controls';
  import { FOCUS_KEYS, listenForGestures, listenInFrame } from '../scene/audio/gesture';
  import type { RoomHandle } from '../scene/main';

  // The window the skip link opens when the address names none.
  const DEFAULT_WINDOW = 'projects';
  // `/#os` (where a bare /os lands): the monitor with SaahilOS's desktop, no window named.
  const DESKTOP = 'os';
  // Once everything the arrival shows is on the GPU, the dark screen fades out over this long, then the wide view holds
  // this long before the flight to the monitor.
  const REVEAL_MS = 500;
  const HOLD_MS = 500;
  // The light tier measures itself behind the dark screen; below this frame rate the drawn monitor takes over.
  const LIGHT_PROBE_MS = 2000;
  const LIGHT_MIN_FPS = 30;
  // A press or key on these is the page's own control, not a move in the room: it does not land the arrival.
  const PAGE_CONTROLS = 'a, button, input, select, textarea, [data-room-ui]';

  const root = document.documentElement;
  const stage = document.querySelector<HTMLElement>('[data-room]')!;
  const world = stage.querySelector<HTMLElement>('[data-room-world]')!;
  const loader = stage.querySelector<HTMLElement>('[data-room-loader]')!;
  const status = stage.querySelector<HTMLElement>('[data-room-status]')!;
  const glass = stage.querySelector<HTMLElement>('[data-monitor-glass]')!;
  const target = windowTarget(stage.dataset.open ?? '', location.hash);
  // The room's first-gesture listener for the music, also set inside the phone's drawn monitor once that is made.
  let soundGesture: ((event: Event) => void) | null = null;

  /**
   * The window this address opens on the monitor: '' for the desktop alone, null for the arrival (About). The route
   * names it; on `/` a hash names one (`/#terminal`), on /films a hash names a film card (`/films#la-la-land`).
   */
  function windowTarget(open: string, hash: string): string | null {
    let fragment = '';
    try {
      fragment = decodeURIComponent(hash.slice(1));
    } catch {
      // a malformed hash names nothing
    }
    if (fragment && fragment !== 'content') {
      if (!open) return fragment === DESKTOP ? '' : fragment;
      if (open === 'films') return `films/${fragment}`;
    }
    return open || null;
  }

  /** SaahilOS in the drawn monitor's glass, unembedded, so a phone gets its phone layout. */
  function drawnScreen() {
    const existing = glass.querySelector('iframe');
    if (existing) return existing;
    const screen = document.createElement('iframe');
    screen.title = 'SaahilOS, on the monitor';
    screen.src = `/os${target ? `#${target}` : ''}`;
    glass.append(screen);
    if (soundGesture) listenInFrame(screen, soundGesture);
    return screen;
  }

  function showDrawnMonitor() {
    root.classList.remove('room', 'room-light', 'room-os');
    root.classList.add('room-2d');
    loader.hidden = true;
    drawnScreen();
  }

  /** The loading line: its width and value follow the room's progress, which never goes back. */
  function loaderUi(el: HTMLElement) {
    const line = el.querySelector<HTMLElement>('[data-room-progress]')!;
    const bar = el.querySelector<HTMLElement>('[data-room-progress-bar]')!;
    el.style.setProperty('--room-reveal-ms', `${REVEAL_MS}ms`);
    return {
      progress(p: number) {
        const pct = Math.round(p * 100);
        bar.style.width = `${pct}%`;
        line.setAttribute('aria-valuenow', String(pct));
      },
      /** The room is ready to be seen: the dark screen fades out, then leaves the page. */
      reveal() {
        el.dataset.state = 'gone';
        el.setAttribute('aria-hidden', 'true');
        setTimeout(() => (el.hidden = true), REVEAL_MS);
      },
    };
  }

  async function bootRoom() {
    const ui = loaderUi(loader);
    const sound = stage.querySelector<HTMLButtonElement>('[data-room-sound]')!;
    const pause = stage.querySelector<HTMLButtonElement>('[data-room-pause]')!;
    const skipLink = document.querySelector<HTMLAnchorElement>('.skip-link');
    const reduced = root.classList.contains('room-reduced');
    const light = root.classList.contains('room-light');
    const back = stage.querySelector<HTMLButtonElement>('[data-monitor-back]')!;
    let room: RoomHandle | null = null;
    // The light tier checks its frame rate before anyone enters.
    let probing = light;
    let entered = false;
    let osRequested = false;
    let paused = reduced;
    pause.setAttribute('aria-pressed', String(paused));
    // The Sound toggle and the volume, remembered across visits.
    const soundControls = mountSoundControls(sound, stage.querySelector<HTMLInputElement>('[data-room-volume]')!);

    const monitor = () => world.querySelector('iframe');

    // Light tier: the camera reached the glass, so SaahilOS takes the whole screen in the drawn monitor.
    const showPhoneOs = (opening: string | null) => {
      const screen = drawnScreen();
      const frameWindow = screen.contentWindow;
      if (opening && frameWindow && frameWindow.location.href !== 'about:blank') {
        // A new hash in the same document: SaahilOS opens that window without reloading or adding history.
        const { pathname, search } = frameWindow.location;
        frameWindow.location.replace(`${pathname}${search}#${opening}`);
      } else if (opening) screen.src = `/os#${opening}`;
      root.classList.add('room-os');
      if (osRequested) screen.focus({ preventScroll: true });
    };
    back.addEventListener('click', () => {
      root.classList.remove('room-os');
      room?.fly('idle');
      stage.focus({ preventScroll: true });
    });
    // Too slow, or the browser took the GPU memory back: the drawn monitor alone, for good.
    const fallBack = (why: string) => {
      console.warn(`room: ${why}; showing the drawn monitor`);
      room?.dispose();
      room = null;
      showDrawnMonitor();
    };

    const enter = () => {
      if (!room || probing || entered) return;
      entered = true;
      ui.reveal();
      root.classList.add('room-started');
      const open = target ?? (osRequested ? DEFAULT_WINDOW : null);
      room.start({ open: open ?? undefined, hold: REVEAL_MS + HOLD_MS, fast: osRequested });
      if (osRequested) monitor()?.focus({ preventScroll: true });
      // The music starts now where the browser allows it, else with the visitor's first press, tap or key.
      const audio = room.audio;
      void audio.autoplay().then((playing) => {
        status.textContent = audio.muted
          ? 'The room has loaded. Sound is off, as you left it; the Sound button turns it on.'
          : playing
            ? 'The room has loaded. Music is on; the Sound button turns it off.'
            : 'The room has loaded. Music starts with your first click or key press; the Sound button turns it off.';
      });
    };

    // Landed at the monitor: the corner label and the second way on, the tour, appear (the floor plan loads only now).
    const onLanded = () => {
      root.classList.add('room-landed');
      if (room) mountHud(stage.querySelector('[data-room-hud]')!, stage.querySelector('[data-room-back]')!, room, stage);
      const tourButton = stage.querySelector<HTMLButtonElement>('[data-tour-open]')!;
      const tourPanel = stage.querySelector<HTMLElement>('[data-tour]')!;
      void loadFloorPlan().then((plan) => plan && room && mountTour(tourButton, tourPanel, room, plan));
    };

    // The music: inside the visitor's first press, tap or key anywhere (the room, its controls, the start of a drag,
    // the OS's frames), as every browser requires. The Sound button decides for itself, so its first press turns the
    // sound on rather than on and off again.
    const startSound = (event: Event) => {
      if ((event.target as Element | null)?.closest?.('[data-room-sound]')) return;
      room?.audio.unlock();
    };
    listenForGestures(window, startSound);
    soundGesture = startSound;
    const drawn = glass.querySelector('iframe');
    if (drawn) listenInFrame(drawn, startSound);

    // A click, a tap or a key while the arrival holds or flies lands it at the monitor; a drag takes the camera over
    // (the room's own navigation does that). Presses on the page's own controls are not moves in the room.
    const onInput = (event: Event) => {
      if (!entered) return;
      if (event.type === 'keydown' && FOCUS_KEYS.has((event as KeyboardEvent).key)) return;
      if ((event.target as Element | null)?.closest?.(PAGE_CONTROLS)) return;
      room?.skipIntro();
    };
    for (const type of ['pointerup', 'keydown']) document.addEventListener(type, onInput, { capture: true });
    // Input inside the monitor stays in its frame; SaahilOS forwards presses and keys up to the room, from the 3D
    // monitor and from the phone's drawn one, so a press there lands the arrival (and starts the sound in Chrome).
    window.addEventListener('message', (event) => {
      const from = event.source;
      if (event.origin !== location.origin || !from || (from !== monitor()?.contentWindow && from !== glass.querySelector('iframe')?.contentWindow)) return;
      const data = event.data as { type?: unknown; key?: unknown } | null;
      const key = typeof data?.key === 'string' ? data.key : null;
      const pressed = data?.type === 'mousedown' || (data?.type === 'press' && key === null);
      const typed = (data?.type === 'keydown' || data?.type === 'press') && key !== null && !FOCUS_KEYS.has(key);
      if (!pressed && !typed) return;
      if (entered) room?.skipIntro();
      room?.audio.unlock();
    });

    pause.addEventListener('click', () => {
      paused = !paused;
      pause.setAttribute('aria-pressed', String(paused));
      root.classList.toggle('room-paused', paused);
      room?.setPaused(paused);
    });
    skipLink?.addEventListener('click', (event) => {
      event.preventDefault();
      osRequested = true;
      if (!entered) {
        enter();
        return;
      }
      room?.openWindow(target || DEFAULT_WINDOW, { fast: true });
      monitor()?.focus({ preventScroll: true });
    });

    try {
      const { startRoom } = await import('../scene/main');
      room = await startRoom(world, {
        osUrl: '/os?embed=1',
        onProgress: ui.progress,
        roomBytes: Number(stage.dataset.roomBytes) || undefined,
        reducedMotion: reduced,
        light,
        onMonitor: showPhoneOs,
        onLost: () => fallBack('the GL context was lost'),
        onLanded,
      });
      const frame = monitor();
      if (frame) listenInFrame(frame, startSound);
      if (light) {
        // Load the phone's SaahilOS behind the dark screen, so it is ready when the camera reaches the glass.
        drawnScreen();
        const fps = await room.measureFps(LIGHT_PROBE_MS);
        probing = false;
        if (fps < LIGHT_MIN_FPS) fallBack(`${fps.toFixed(0)} fps on the light tier`);
        if (!room) return;
      }
      room.setPaused(paused);
      soundControls.attach(room.audio);
      // Everything the arrival shows is loaded (SaahilOS's full-size pictures may load now too).
      root.classList.add('room-ready');
      enter();
    } catch (error) {
      console.error('room: failed to load', error);
      room = null;
      showDrawnMonitor();
    }
  }

  /** Runs once the text has painted, so no scene request competes with it (a timer covers browsers without paint timing). */
  function afterFirstPaint(run: () => void) {
    let done = false;
    const once = () => {
      if (done) return;
      done = true;
      observer?.disconnect();
      run();
    };
    let observer: PerformanceObserver | null = null;
    try {
      observer = new PerformanceObserver((list) => {
        if (list.getEntriesByName('first-contentful-paint').length) once();
      });
      observer.observe({ type: 'paint', buffered: true });
    } catch {
      // no paint timing here
    }
    setTimeout(once, 1500);
  }

  if (root.classList.contains('room')) afterFirstPaint(() => void bootRoom());
  else if (root.classList.contains('room-2d')) {
    showDrawnMonitor();
    document.querySelector('.skip-link')?.addEventListener('click', (event) => {
      event.preventDefault();
      glass.querySelector('iframe')?.focus();
    });
  }
</script>

<style>
  /* The room is the whole page: nothing above, below or beside it. */
  .room-stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--ink);
  }

  .room-stage:focus {
    outline: none;
  }

  .room-world,
  .room-controls,
  .room-stage :global(.room-loader) {
    display: none;
  }

  :global(html.room) .room-world {
    display: block;
  }

  :global(html.room) .room-controls {
    display: flex;
  }

  :global(html.room) .room-stage :global(.room-loader:not([hidden])) {
    display: grid;
  }

  :global(html.room) .room-stage :global(.monitor-frame) {
    display: none;
  }

  /* Light tier: the camera reached the glass and SaahilOS takes the screen, in the drawn monitor over the room. */
  :global(html.room.room-os) .room-stage :global(.monitor-frame) {
    display: block;
    z-index: 5;
    animation: os-in 260ms ease-out;
  }

  :global(html.room.room-os) .room-controls {
    display: none;
  }

  @keyframes os-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.room.room-os) .room-stage :global(.monitor-frame) {
      animation: none;
    }
  }

  .room-world {
    position: absolute;
    inset: 0;
    /* A finger on the room drags the view; the browser must not pan or zoom the page instead. */
    touch-action: none;
  }

  .room-world :global(.room-css),
  .room-world :global(.room-webgl) {
    position: absolute;
    inset: 0;
  }

  .room-world :global(.room-webgl) {
    z-index: 1;
    pointer-events: none;
  }

  .room-world :global(.room-monitor) {
    background: #0c0b0a;
  }

  .room-world :global(.room-label) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 0.2rem 0.55rem;
    background: var(--ink);
    color: var(--paper);
    border-bottom: 1px solid var(--thread);
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    pointer-events: none;
    white-space: nowrap;
  }

  .room-controls {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 4;
    gap: var(--space-2);
  }

  .room-controls button {
    padding: 0.3rem 0.75rem;
    border: 1px solid rgb(168 159 145 / 0.5);
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    cursor: pointer;
  }

  .room-controls button:hover {
    border-color: var(--paper);
  }

  .room-volume {
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
    border: 1px solid rgb(168 159 145 / 0.5);
    background: var(--ink);
  }

  .room-volume input {
    width: 5.5rem;
    accent-color: var(--paper);
    cursor: pointer;
  }

  .room-controls button[aria-pressed='true'] {
    background: var(--paper);
    color: var(--ink);
  }

  .room-sound {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .room-sound svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .room-sound[aria-pressed='true'] .room-sound-off,
  .room-sound[aria-pressed='false'] .room-sound-on {
    display: none;
  }

  /* Until the room's sound first starts, the toggle breathes a soft paper-coloured glow (the room's accent red is lost
     against the desk behind it), so a visitor knows there is sound to hear; it stops once the sound is on, and never
     shows for a visitor who turned it off. */
  .room-controls .room-sound[data-hint] {
    border-color: rgb(237 228 211 / 0.85);
    animation: sound-hint 2.6s ease-in-out infinite;
  }

  @keyframes sound-hint {
    0%,
    100% {
      box-shadow: 0 0 4px 0 rgb(237 228 211 / 0.15);
    }
    50% {
      box-shadow: 0 0 14px 2px rgb(237 228 211 / 0.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-controls .room-sound[data-hint] {
      animation: none;
      box-shadow: 0 0 10px 1px rgb(237 228 211 / 0.35);
    }
  }
</style>
