---
import Base from '../layouts/Base.astro';
import { parseAssetsRegister } from '../lib/assets-register';

const sections = parseAssetsRegister().filter((section) => section.rows.length > 0);
const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Base title="Credits" description="Who made the code, fonts, models, images and sounds this site is built from, and under which licences.">
  <h1 class="page-title">Credits</h1>
  <p class="page-lead">
    Based on <a href="https://github.com/henryjeff/portfolio-website">Henry Heffernan's portfolio</a>, heavily edited.
    Ideas from <a href="https://github.com/alanagoyal/alanagoyal">Alana Goyal's site</a>. Every file below is used under
    the licence shown.
  </p>

  {
    sections.map((section) => (
      <section class="credits" aria-labelledby={`credits-${slug(section.title)}`}>
        <h2 class="section-title" id={`credits-${slug(section.title)}`}>
          {section.title}
        </h2>
        <dl class="roll link-list">
          {section.rows.map((row) => (
            <div class="roll-row">
              <dt>{row.usedFor}</dt>
              <dd>
                <p class="roll-asset">{row.sourceUrl ? <a href={row.sourceUrl}>{row.asset}</a> : row.asset}</p>
                <p class="meta">
                  {row.author}, {row.licence}
                </p>
                {row.changes && <p class="meta">{row.changes}</p>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }
</Base>

<style>
  /* An end-credits roll: what each thing does on the left, who made it on the right, meeting at a centre line. */
  .roll {
    display: grid;
    gap: var(--space-4);
    max-width: 52rem;
  }

  .roll-row dt {
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    color: var(--dust);
  }

  .roll-row dd {
    margin: 0;
  }

  .roll-asset {
    font-size: var(--size-body);
  }

  @media (min-width: 56rem) {
    .roll-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-5);
      align-items: baseline;
    }

    .roll-row dt {
      text-align: right;
    }
  }
</style>
