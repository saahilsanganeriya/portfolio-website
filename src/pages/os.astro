---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { parseAssetsRegister } from '../lib/assets-register';
import { getPosts, getProjects, isoDay } from '../lib/content';
import { filmsData } from '../lib/films';
import { windowDiary } from '../os/apps/films/diary';
import { favourites as loadFavourites, osImage, osWallpaper, ovenList, projectFigures } from '../os/build-data';
import SaahilOS from '../os/SaahilOS';
import pixelFont from '../os/assets/fonts/PixelOperator.woff2?url';
import type { OsIndex } from '../os/types';

const { featured, archive } = await getProjects();
const posts = await getPosts();
const pages = await getCollection('pages');
const story = (await getCollection('story')).sort((a, b) => a.data.n - b.data.n);
const favourites = loadFavourites();

// Lists only; window bodies load from /content/<collection>/<slug>.json when a window opens.
const index: OsIndex = {
  projects: await Promise.all(
    [...featured, ...archive].map(async ({ id, data }) => ({
      slug: id,
      title: data.title,
      summary: data.summary,
      year: data.year,
      years: data.years,
      status: data.status,
      role: data.role,
      team: data.team,
      stack: data.stack,
      featured: data.featured,
      links: data.links,
      cover: data.cover && (await osImage(data.cover, data.coverAlt ?? '')),
      figures: await projectFigures(id),
    })),
  ),
  posts: posts.map(({ id, data }) => ({ slug: id, title: data.title, date: isoDay(data.date), summary: data.summary, tags: data.tags })),
  pages: pages.map(({ id, data }) => ({ slug: id, title: data.title, summary: data.summary })),
  story: story.map(({ id, data }) => ({ slug: id, n: data.n, title: data.title, intertitle: data.intertitle })),
  films: windowDiary(filmsData, favourites),
  favourites,
  oven: ovenList(),
  credits: parseAssetsRegister().filter((section) => section.rows.length > 0),
  wallpaper: await osWallpaper(),
};
---

<Base
  title="SaahilOS"
  description="A small desktop computer with my projects, writing, films and story in its windows."
  bare
>
  <Fragment slot="head">
    <script is:inline>
      // SaahilOS lives on the room's monitor (?embed=1) and in the drawn monitor (framed); opened as a page of its own
      // it is the room instead, ending on the monitor with the window the hash names (/#os: the desktop alone).
      if (window.top === window.self && !new URLSearchParams(location.search).has('embed')) {
        location.replace('/#' + (location.hash.slice(1) || 'os'));
      }
    </script>
    <link rel="preload" href={pixelFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Inside the room's monitor (?embed=1), pass pointer and key events up so the room keeps reacting to them,
      // as Henry Heffernan's OS does; runs before the island hydrates.
      if (new URLSearchParams(location.search).get('embed') === '1' && window.parent !== window) {
        document.documentElement.dataset.embedded = '';
        const post = (message) => window.parent.postMessage(message, location.origin);
        addEventListener('mousemove', (e) => post({ type: 'mousemove', clientX: e.clientX, clientY: e.clientY }));
        addEventListener('mousedown', () => post({ type: 'mousedown' }));
        addEventListener('mouseup', () => post({ type: 'mouseup' }));
        addEventListener('keydown', (e) => post({ type: 'keydown', key: e.key }));
        addEventListener('keyup', (e) => post({ type: 'keyup', key: e.key }));
      }
    </script>
  </Fragment>
  <SaahilOS client:load index={index} />
</Base>
