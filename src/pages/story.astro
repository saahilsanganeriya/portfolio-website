---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import MePhoto from '../components/MePhoto.astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import headshot from '../assets/story/headshot.webp';
import { CARD_THREAD, END_SCENE, TITLE_THREAD, numeral, sceneDirection, type ThreadHold } from '../story/scenes';
import '../story/reel.css';

const chapters = await Promise.all(
  (await getCollection('story'))
    .sort((a, b) => a.data.n - b.data.n)
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content, direction: sceneDirection(entry.id) })),
);
const finalChapter = chapters.at(-1)!.entry;
const frameCount = chapters.length * 2 + 2;

const wordCount = (text: string) => text.split(/\s+/).filter(Boolean).length;
// Autoplay holds each frame long enough to read it at about 220 words a minute, plus time to look.
const cardDwell = (text: string) => (2.5 + wordCount(text) * 0.3).toFixed(1);
const sceneDwell = (text: string) => (3 + wordCount(text) * 0.27).toFixed(1);

const holdAttrs = ({ head, tail, slack }: ThreadHold) => ({
  'data-head': head.join(','),
  'data-tail': tail.join(','),
  'data-slack': String(slack),
});
const photoWidths = [640, 960, 1280, 1600, 1920];
const photoSizes = '(min-aspect-ratio: 1/1) 80vw, 100vw';
---

<Base
  title="The Thread"
  description="A short silent film in six scenes: Delhi, a spinning mill, a flight to Atlanta, research, building, and home."
  bare
  skipLabel="Skip to the story"
>
  <script is:inline slot="head">
    (() => {
      // The reel plays in SaahilOS's story window (?embed=1); opened as a page of its own it is the room, with that window open.
      if (window.top === window.self && !new URLSearchParams(location.search).has('embed')) {
        location.replace('/#story');
        return;
      }
      const root = document.documentElement;
      if (new URLSearchParams(location.search).get('embed') === '1') root.dataset.embed = '';
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.dataset.reel = 'live';
    })();
  </script>

  <main id="content" class="reel" tabindex="-1" data-reel style={`--frames: ${frameCount}`}>
    <div class="reel-gate" data-gate>
      <header class="reel-bar chrome">
        <a href="/">{SITE.name}</a>
        <a href="/about">Read the story as text</a>
      </header>

      <div class="reel-strip" data-strip>
        <section
          class="reel-frame reel-frame--title"
          id="title"
          aria-labelledby="reel-title"
          style="--i: 0"
          data-frame
          data-kind="title"
          data-dwell="5"
          {...holdAttrs(TITLE_THREAD)}
        >
          <div class="title-card">
            <h1 class="title-name" id="reel-title">The Thread</h1>
            <p class="title-sub">A short film in six scenes, by {SITE.name}.</p>
            <ol class="title-scenes" aria-label="Scenes">
              {
                chapters.map(({ entry }) => (
                  <li>
                    <a href={`#chapter-${entry.data.n}`}>
                      <span class="numeral" aria-hidden="true">
                        {numeral(entry.data.n)}
                      </span>
                      {entry.data.title}
                    </a>
                  </li>
                ))
              }
            </ol>
            <p class="title-hint">Scroll, or press the arrow keys, to advance one frame at a time.</p>
          </div>
        </section>

        {
          chapters.map(({ entry, Content, direction }, k) => (
            <section class="reel-chapter" id={`chapter-${entry.data.n}`} aria-labelledby={`chapter-${entry.data.n}-title`}>
              <div
                class="reel-frame reel-frame--card"
                style={`--i: ${2 * k + 1}`}
                data-frame
                data-kind="card"
                data-dwell={cardDwell(entry.data.intertitle)}
                {...holdAttrs(CARD_THREAD)}
              >
                <div class="card">
                  <p class="card-numeral" aria-hidden="true">
                    {numeral(entry.data.n)}
                  </p>
                  <p class="card-text">{entry.data.intertitle}</p>
                  <svg class="card-mark" viewBox="0 0 64 22" fill="none" aria-hidden="true" focusable="false">
                    <path
                      d="M1 15.5C10 16.4 19 16.2 25.5 14.6C29.4 13.6 32 9.6 30.6 5.6C29.3 2 24.6 2.4 24 6.4C23.4 10.6 27.6 14.4 34 15C43 15.8 53 14.6 63 13.4"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      vector-effect="non-scaling-stroke"
                    />
                  </svg>
                </div>
              </div>
              <div
                class="reel-frame reel-frame--scene"
                style={`--i: ${2 * k + 2}`}
                data-frame
                data-kind="scene"
                data-side={direction.side}
                data-focus={direction.focus.join(',')}
                data-dwell={sceneDwell(entry.body ?? '')}
                {...holdAttrs(direction.thread)}
              >
                <Image
                  class="scene-photo"
                  src={entry.data.background.src}
                  alt={entry.data.background.alt}
                  widths={photoWidths}
                  sizes={photoSizes}
                  quality={55}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${direction.focus[0]}% ${direction.focus[1]}%`}
                  data-photo
                />
                <div class="scene-scrim" />
                <div class="scene-words">
                  <h2 class="scene-title" id={`chapter-${entry.data.n}-title`}>
                    {entry.data.title}
                  </h2>
                  <div class="scene-body">
                    {entry.data.photo && (
                      <MePhoto file={entry.data.photo} side={direction.side === 'left' ? 'right' : 'left'} variant="reel" />
                    )}
                    <Content />
                  </div>
                </div>
                <p class="scene-credit">
                  Photo: <a href={entry.data.background.sourceUrl}>{entry.data.background.credit}</a>
                </p>
              </div>
            </section>
          ))
        }

        <section
          class="reel-frame reel-frame--end reel-frame--scene"
          id="the-end"
          aria-labelledby="the-end-title"
          style={`--i: ${frameCount - 1}`}
          data-frame
          data-kind="end"
          data-side="left"
          data-focus={END_SCENE.focus.join(',')}
          data-tie={END_SCENE.tie.join(',')}
          data-dwell="0"
          {...holdAttrs(END_SCENE.thread)}
        >
          <Image
            class="scene-photo"
            src={finalChapter.data.background.src}
            alt={finalChapter.data.background.alt}
            widths={photoWidths}
            sizes={photoSizes}
            quality={55}
            loading="lazy"
            decoding="async"
            style={`object-position: ${END_SCENE.focus[0]}% ${END_SCENE.focus[1]}%`}
            data-photo
          />
          <div class="scene-scrim" />
          <div class="end-words">
            <h2 class="end-title" id="the-end-title">The end</h2>
            <Image
              class="end-portrait"
              src={headshot}
              alt="Saahil Sanganeriya, smiling, in a suit, in front of autumn trees and a brick building."
              width={208}
              densities={[1, 2]}
              loading="lazy"
              decoding="async"
            />
            <p class="end-name">{SITE.name}</p>
            <ul class="end-links link-list">
              <li><a href="/about">About me</a></li>
              <li><a href="/projects">Projects</a></li>
              <li><a href="/blog">Writing</a></li>
              <li><a href="/">The room</a></li>
            </ul>
          </div>
        </section>
      </div>

      <canvas class="reel-thread" data-thread aria-hidden="true"></canvas>
      <canvas class="reel-film" data-film aria-hidden="true"></canvas>

      <div class="reel-controls" role="group" aria-label="Reel" data-controls hidden>
        <button type="button" class="reel-button" data-play>Play</button>
        <button type="button" class="reel-button" data-back>Back</button>
        <button type="button" class="reel-button" data-next>Next</button>
        <p class="reel-counter"><span class="visually-hidden">Frame </span><span data-count>1</span> of {frameCount}</p>
      </div>
    </div>

    <div class="reel-steps" aria-hidden="true">
      {Array.from({ length: frameCount }, () => <div class="reel-step" data-step />)}
    </div>
  </main>

  <div class="frame chrome">
    <SiteFooter />
  </div>
</Base>

<script>
  import { startReel } from '../story/reel';
  startReel();
</script>
