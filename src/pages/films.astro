---
import FormattedDate from '../components/FormattedDate.astro';
import Base from '../layouts/Base.astro';
import { groupByYear } from '../lib/content';
import { filmsData, ratingLabel, stars, type FilmEntry } from '../lib/films';
import { diaryKey } from '../lib/films/format';

const { entries, posters, profile, fetchedAt } = filmsData;
const day = (iso: string) => new Date(`${iso}T00:00:00Z`);

const wall = posters
  .map((slug) => entries.find((entry) => entry.slug === slug))
  .filter((film): film is FilmEntry => film !== undefined);
const diaryYears = groupByYear(entries, (entry) => Number(entry.watchedDate.slice(0, 4)));
---

<Base title="Films" description="What I have been watching, from my Letterboxd diary: ratings, rewatches and short reviews.">
  <h1 class="page-title">Films</h1>
  <p class="page-lead">
    What I have been watching, from my <a href={profile}>Letterboxd diary</a>. Last updated <span data-films-updated
      ><FormattedDate date={new Date(fetchedAt)} /></span
    >.
  </p>

  {
    wall.length > 0 && (
      <section aria-labelledby="wall">
        <h2 class="section-title" id="wall">
          On the wall
        </h2>
        <p class="section-note">The four films whose posters hang in the room.</p>
        <ul class="wall link-list">
          {wall.map((film) => (
            <li id={film.slug}>
              <p class="wall-title">
                <a href={film.url}>{film.title}</a>
              </p>
              <p class="meta">
                {film.year}
                {film.rating && (
                  <>
                    , <span aria-hidden="true">{stars(film.rating)}</span>
                    <span class="visually-hidden">{ratingLabel(film.rating)}</span>
                  </>
                )}
                , last watched{' '}
                <span data-last-watched>
                  <FormattedDate date={day(film.watchedDate)} />
                </span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section aria-labelledby="diary" data-diary>
    <h2 class="section-title" id="diary">Diary</h2>
    {
      diaryYears.map(([year, films]) => (
        <div class="chrono" data-year={year}>
          <p class="chrono-label">{year}</p>
          <ol class="diary link-list">
            {films.map((film) => (
              <li data-film={diaryKey(film)}>
                <span class="meta">
                  <FormattedDate date={day(film.watchedDate)} style="short" />
                </span>
                <span class="diary-film">
                  <a href={film.url}>{film.title}</a> <span class="meta">{film.year}</span>
                  {film.rewatch && <span class="meta">, rewatch</span>}
                </span>
                <span class="diary-rating">
                  {film.rating && (
                    <>
                      <span aria-hidden="true">{stars(film.rating)}</span>
                      <span class="visually-hidden">{ratingLabel(film.rating)}</span>
                    </>
                  )}
                </span>
                {film.review && <p class="diary-review">{film.review}</p>}
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .section-note {
    margin-top: calc(-1 * var(--space-3));
    margin-bottom: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    color: var(--dust);
  }

  .wall {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    padding: 0;
    list-style: none;
  }

  .wall-title {
    font-size: var(--size-h1);
    font-weight: 300;
    line-height: var(--leading-tight);
  }

  /* Global: the client refresh adds diary rows, which carry no scope attribute. */
  :global(.diary) {
    max-width: var(--measure);
    padding: 0;
    list-style: none;
  }

  :global(.diary li) {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 0 var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
  }

  :global(.diary-film) {
    font-size: var(--size-body);
  }

  :global(.diary-rating) {
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    letter-spacing: 0.08em;
  }

  :global(.diary-review) {
    grid-column: 2 / -1;
    margin-top: var(--space-1);
    color: var(--dust);
    font-style: italic;
    white-space: pre-line;
  }
</style>

<script>
  import { diaryKey, ratingLabel, stars } from '../lib/films/format';
  import type { FilmEntry, FilmsData } from '../lib/films/merge';

  // The prerendered diary is the page without JavaScript. After load, watches the build did not have join it from
  // the live merge (/api/films.json, cached for up to an hour), each in its place by date; nothing is removed.
  const shortDay = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  const longDay = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

  const isFilmsData = (value: unknown): value is FilmsData =>
    typeof value === 'object' && value !== null && Array.isArray((value as FilmsData).entries);

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function time(isoDay: string, format: Intl.DateTimeFormat) {
    const day = isoDay.slice(0, 10);
    const node = el('time', undefined, format.format(new Date(`${day}T00:00:00Z`)));
    node.dateTime = day;
    return node;
  }

  function diaryRow(film: FilmEntry) {
    const row = el('li');
    row.dataset.film = diaryKey(film);
    const date = el('span', 'meta');
    date.append(time(film.watchedDate, shortDay));
    const title = el('span', 'diary-film');
    const link = el('a', undefined, film.title);
    link.href = film.url;
    title.append(link, ' ', el('span', 'meta', String(film.year)));
    if (film.rewatch) title.append(el('span', 'meta', ', rewatch'));
    const rating = el('span', 'diary-rating');
    if (film.rating) {
      const shown = el('span', undefined, stars(film.rating));
      shown.setAttribute('aria-hidden', 'true');
      rating.append(shown, el('span', 'visually-hidden', ratingLabel(film.rating)));
    }
    row.append(date, title, rating);
    if (film.review) row.append(el('p', 'diary-review', film.review));
    return row;
  }

  function yearList(diary: HTMLElement, year: string) {
    const existing = diary.querySelector<HTMLOListElement>(`[data-year="${year}"] ol`);
    if (existing) return existing;
    const group = el('div', 'chrono');
    group.dataset.year = year;
    const list = el('ol', 'diary link-list');
    group.append(el('p', 'chrono-label', year), list);
    const older = [...diary.querySelectorAll<HTMLElement>('[data-year]')].find((g) => (g.dataset.year ?? '') < year);
    diary.insertBefore(group, older ?? null);
    return list;
  }

  async function refresh() {
    const diary = document.querySelector<HTMLElement>('[data-diary]');
    if (!diary) return;
    const data: unknown = await fetch('/api/films.json')
      .then((response) => (response.ok ? response.json() : null))
      .catch(() => null);
    if (!isFilmsData(data) || data.entries.length === 0) return;

    const shown = new Set([...diary.querySelectorAll<HTMLElement>('[data-film]')].map((row) => row.dataset.film));
    for (const film of data.entries) {
      if (shown.has(diaryKey(film))) continue;
      const list = yearList(diary, film.watchedDate.slice(0, 4));
      // Rows run newest first; a new row goes above the first strictly older one, after same-day rows.
      const older = [...list.children].find((row) => ((row as HTMLElement).dataset.film ?? '').slice(-10) < film.watchedDate);
      list.insertBefore(diaryRow(film), older ?? null);
    }

    document.querySelector('[data-films-updated]')?.replaceChildren(time(data.fetchedAt, longDay));
    for (const wall of document.querySelectorAll<HTMLElement>('[data-last-watched]')) {
      const slug = wall.closest('li')?.id;
      const latest = data.entries.find((film) => film.slug === slug);
      const current = wall.querySelector('time')?.dateTime ?? '';
      if (latest && latest.watchedDate > current) wall.replaceChildren(time(latest.watchedDate, longDay));
    }
  }

  if (document.readyState === 'complete') void refresh();
  else addEventListener('load', () => void refresh(), { once: true });
</script>
