---
import SiteFooter from '../components/SiteFooter.astro';
import ThreadDivider from '../components/ThreadDivider.astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const index = [
  { href: '/projects', label: 'Projects', note: 'Write-ups of what I have built.' },
  { href: '/blog', label: 'Writing', note: 'Essays, and reviews from my film diary.' },
  { href: '/films', label: 'Films', note: 'What I have been watching lately.' },
  { href: '/story', label: 'A Narrative in a Frame', note: 'My story, told as a short film.' },
  { href: '/os', label: 'SaahilOS', note: 'The desktop on the room’s monitor, as a full page.' },
  { href: '/about', label: 'About', note: 'Where I come from and what I want to build.' },
  { href: '/resume', label: 'Résumé', note: 'Work and education on one page.' },
  { href: '/credits', label: 'Credits', note: 'The people and code this site is built on.' },
];
---

<Base title={SITE.name} description={SITE.description} bare skipLabel="Skip the room">
  {/* The 3D room renders above this text index; the index stays as its plain HTML equivalent. */}
  <div class="frame">
    <main id="content" class="home" tabindex="-1">
      <h1 class="home-name">{SITE.name}</h1>
      <ThreadDivider class="home-thread" />
      <p class="home-line">
        I am a software engineer at Mercor, where I build the systems that anonymize enterprise data for AI
        post-training. I studied computer science at Georgia Tech.
      </p>
      <nav aria-label="Site index">
        <ul class="index">
          {
            index.map(({ href, label, note }) => (
              <li>
                <a href={href}>{label}</a>
                <span>{note}</span>
              </li>
            ))
          }
        </ul>
      </nav>
    </main>
    <SiteFooter />
  </div>
</Base>

<style>
  .home {
    padding-top: clamp(var(--space-6), 14vh, 10rem);
  }

  .home-name {
    font-size: var(--size-display);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .home-name + :global(.home-thread) {
    margin-top: var(--space-4);
  }

  .home-line {
    max-width: 34em;
    margin-top: var(--space-4);
    font-size: var(--size-lead);
    line-height: 1.45;
  }

  .index {
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .index li {
    display: grid;
    gap: 0 var(--space-4);
  }

  .index a {
    font-size: var(--size-h2);
    line-height: 1.3;
  }

  .index span {
    font-family: var(--font-sans);
    font-size: var(--size-ui);
    color: var(--dust);
  }

  @media (min-width: 56rem) {
    .index li {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
