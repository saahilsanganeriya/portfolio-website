---
// While the room loads: the void the room floats in, and one thin line that fills as its files and steps arrive. The
// page script (layouts/Room.astro) moves the line and fades the screen out once the room is ready to be seen.
---

<div class="room-loader" data-room-loader data-room-ui>
  <div class="room-loader-line" role="progressbar" aria-label="Loading the room" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-room-progress>
    <span data-room-progress-bar></span>
  </div>
</div>

<style>
  .room-loader {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    background: var(--room-void, var(--ink));
    /* The page sets --room-reveal-ms to the time the room's fade-in takes. */
    transition: opacity var(--room-reveal-ms, 500ms) ease-out;
  }

  .room-loader[data-state='gone'] {
    opacity: 0;
    pointer-events: none;
  }

  .room-loader-line {
    position: relative;
    width: min(14rem, 40vw);
    height: 1px;
    background: rgb(168 159 145 / 0.16);
    /* A visit that loads at once (from the cache) never sees the line flash: it shows only after a moment. */
    opacity: 0;
    animation: line-in 400ms ease-out 300ms forwards;
  }

  .room-loader-line span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: rgb(237 228 211 / 0.6);
    transition: width 200ms linear;
  }

  @keyframes line-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-loader-line {
      animation-duration: 1ms;
    }

    .room-loader-line span {
      transition: none;
    }
  }
</style>
