---
// "Take the tour" and the map of the room it opens (brief §0, §1): a floor plan drawn from public/room/floorplan.json,
// the stops of src/scene/tour.json in order (work first), a you-are-here mark that follows the camera, and "Play the
// tour", one slow glide through the room during which the map shrinks to a small inset and each stop's caption fades
// in and out. Never the default: the button waits in the bottom-left corner, away from the monitor, drawn like the
// Sound control across the room (its glyph is the map's own plan and red you-are-here dot). Behaviour is in RoomTourMap.ts.
---

<button type="button" class="room-tour-open" aria-expanded="false" aria-controls="room-tour" data-room-ui data-tour-open hidden>
  <svg class="room-tour-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path class="room-tour-glyph-plan" d="M2.5 3.5h11v9h-11zM2.5 8.5h3.5M9 3.5v3"></path>
    <circle class="room-tour-glyph-here" cx="10.6" cy="9.9" r="1.35"></circle>
  </svg>
  Take the tour
</button>

<section id="room-tour" class="room-tour" aria-labelledby="room-tour-title" data-room-ui data-tour hidden>
  <header class="room-tour-head">
    <h2 id="room-tour-title">Map of the room</h2>
    <button type="button" class="room-tour-close" data-tour-close>Close</button>
  </header>
  <div class="room-tour-plan" data-tour-plan>
    <svg aria-hidden="true" focusable="false" data-tour-svg>
      <g data-tour-furniture></g>
      <polygon class="room-tour-walls" data-tour-outline></polygon>
      <g data-tour-walls></g>
      <g data-tour-doors></g>
      <g class="room-tour-here" data-tour-here>
        <path class="room-tour-view" d="M0 0 L0.9 -0.42 A1 1 0 0 1 0.9 0.42 Z"></path>
        <circle class="room-tour-dot" r="0.13"></circle>
      </g>
    </svg>
    <div class="room-tour-markers" aria-hidden="true" data-tour-markers></div>
  </div>
  <ol class="room-tour-stops" aria-label="Stops" data-tour-stops></ol>
  <p class="room-tour-caption" aria-live="polite" data-tour-caption></p>
  <div class="room-tour-actions">
    <button type="button" class="room-tour-play" data-tour-play>Play the tour</button>
  </div>
</section>

<style>
  .room-tour-open,
  .room-tour {
    position: absolute;
    left: var(--space-3);
    z-index: 4;
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    color: var(--paper);
  }

  /* Shown once the camera has landed at the desk and the floor plan has loaded; never over SaahilOS on a phone. Its
     box matches the Sound control's; under the pointer or the keyboard it warms to walnut, and open it inverts, as a
     pressed room control does. */
  .room-tour-open {
    bottom: var(--space-3);
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem 0.3rem 0.6rem;
    border: 1px solid rgb(168 159 145 / 0.5);
    border-radius: 0;
    background: var(--ink);
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  :global(html.room.room-landed:not(.room-os)) .room-tour-open:not([hidden]) {
    display: inline-flex;
  }

  .room-tour-glyph {
    width: 1rem;
    height: 1rem;
    flex: none;
    overflow: visible;
  }

  .room-tour-glyph-plan {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .room-tour-glyph-here {
    fill: var(--thread);
    stroke: var(--paper);
    stroke-width: 0.8;
    transition: transform 0.2s ease;
    transform-origin: 10.6px 9.9px;
  }

  .room-tour-open:hover,
  .room-tour-open:focus-visible {
    border-color: var(--paper);
    background: var(--walnut);
  }

  .room-tour-open:hover .room-tour-glyph-here,
  .room-tour-open:focus-visible .room-tour-glyph-here {
    transform: scale(1.25);
  }

  .room-tour-open[aria-expanded='true'] {
    border-color: var(--paper);
    background: var(--paper);
    color: var(--ink);
  }

  .room-tour-open[aria-expanded='true'] .room-tour-glyph-here {
    stroke: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .room-tour-open,
    .room-tour-glyph-here {
      transition: none;
    }
  }

  .room-tour {
    bottom: calc(var(--space-3) + 2.4rem);
    width: min(22rem, calc(100vw - 2 * var(--space-3)));
    max-height: calc(100% - 5rem);
    overflow-y: auto;
    padding: var(--space-3);
    border: 1px solid rgb(168 159 145 / 0.5);
    background: var(--ink);
  }

  :global(html.room-os) .room-tour,
  :global(html.room-2d) .room-tour {
    display: none;
  }

  .room-tour-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .room-tour-head h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dust);
  }

  .room-tour button {
    border-radius: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .room-tour-close,
  .room-tour-play {
    padding: 0.25rem 0.65rem;
    border: 1px solid rgb(168 159 145 / 0.5);
    background: var(--ink);
  }

  .room-tour-close:hover,
  .room-tour-play:hover {
    border-color: var(--paper);
  }

  /* The plan: an architect's line drawing, walls in paper, furniture and doors in dust, the visitor in thread. */
  .room-tour-plan {
    position: relative;
    margin: 0 0 var(--space-3);
  }

  .room-tour-plan svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .room-tour-plan :global(.room-tour-walls) {
    fill: rgb(237 228 211 / 0.04);
    stroke: var(--paper);
    stroke-width: 2px;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  .room-tour-plan :global(.room-tour-walls.room-tour-floor) {
    stroke: var(--dust);
    stroke-width: 1px;
    stroke-dasharray: 2 3;
  }

  .room-tour-plan :global(.room-tour-wall) {
    stroke: var(--paper);
    stroke-width: 3px;
    stroke-linecap: square;
    vector-effect: non-scaling-stroke;
  }

  /* A window: the wall cut open and a single pane line through the gap. */
  .room-tour-plan :global(.room-tour-window-gap) {
    stroke: var(--ink);
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
  }

  .room-tour-plan :global(.room-tour-window) {
    stroke: var(--paper);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .room-tour-plan :global(.room-tour-furniture) {
    fill: none;
    stroke: var(--dust);
    stroke-width: 1px;
    opacity: 0.7;
    vector-effect: non-scaling-stroke;
  }

  .room-tour-plan :global(.room-tour-door) {
    stroke: var(--ink);
    stroke-width: 4px;
    vector-effect: non-scaling-stroke;
  }

  .room-tour-plan :global(.room-tour-door-swing) {
    fill: none;
    stroke: var(--dust);
    stroke-width: 1px;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }

  .room-tour-view {
    fill: rgb(237 228 211 / 0.16);
  }

  .room-tour-dot {
    fill: var(--thread);
    stroke: var(--paper);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .room-tour-markers {
    position: absolute;
    inset: 0;
  }

  .room-tour-markers :global(span) {
    position: absolute;
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    margin: -0.675rem 0 0 -0.675rem;
    border: 1px solid var(--paper);
    border-radius: 50%;
    background: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .room-tour-markers :global(span[data-current]),
  .room-tour-markers :global(span[data-lit]) {
    background: var(--paper);
    color: var(--ink);
  }

  /* The stops as a numbered list: the plan's numbers, named. Work first, so the first column reads as the CV. */
  .room-tour-stops {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem var(--space-2);
    margin: 0 0 var(--space-2);
    padding: 0;
    list-style: none;
  }

  .room-tour-stops :global(button) {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
    width: 100%;
    padding: 0.2rem 0.3rem;
    border: 1px solid transparent;
    background: none;
    text-align: left;
  }

  .room-tour-stops :global(button:hover),
  .room-tour-stops :global(button[aria-current='location']) {
    border-color: rgb(168 159 145 / 0.5);
  }

  .room-tour-stops :global(.n) {
    min-width: 1.1rem;
    font-family: var(--font-mono);
    color: var(--dust);
  }

  .room-tour-caption {
    min-height: 1.5em;
    margin: 0 0 var(--space-2);
    color: var(--dust);
    transition: opacity 0.5s ease;
  }

  /* While the tour glides, each stop's caption fades out as the camera moves on and the next fades in. */
  .room-tour-caption[data-fade='out'] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .room-tour-caption {
      transition: none;
    }
  }

  .room-tour-caption :global(strong) {
    font-weight: 400;
    color: var(--paper);
  }

  .room-tour-actions {
    display: flex;
    justify-content: flex-end;
  }

  /* While the tour plays, the map shrinks to a you-are-here inset beside the stop's caption, out of the frame's way. */
  .room-tour[data-playing] {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 var(--space-3);
    align-items: start;
    width: min(27rem, calc(100vw - 2 * var(--space-3)));
    padding: var(--space-2) var(--space-3);
  }

  .room-tour[data-playing] .room-tour-head,
  .room-tour[data-playing] .room-tour-stops {
    display: none;
  }

  .room-tour[data-playing] .room-tour-plan {
    grid-row: span 2;
    margin: 0;
  }

  .room-tour[data-playing] .room-tour-markers :global(span) {
    width: 0.8rem;
    height: 0.8rem;
    margin: -0.4rem 0 0 -0.4rem;
    font-size: 0;
  }

  .room-tour[data-playing] .room-tour-caption {
    min-height: 3em;
    margin: 0 0 var(--space-2);
    line-height: 1.45;
  }
</style>
