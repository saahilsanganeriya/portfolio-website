---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot/saahil-sanganeriya.webp';
---

<Image class="headshot" src={headshot} alt="Saahil Sanganeriya" width={128} densities={[1, 2]} loading="eager" decoding="async" />

<style>
  .headshot {
    display: block;
    width: 8rem;
    height: auto;
    margin-top: var(--space-4);
  }
</style>
