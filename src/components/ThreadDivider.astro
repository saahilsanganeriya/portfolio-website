---
// The site's one signature: a slack thread with a single loop, from the spinning mill. Decorative, static.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['thread', className]} viewBox="0 0 640 36" fill="none" aria-hidden="true" focusable="false">
  <path
    d="M1 23C54 25.5 92 27 118 24.5C136 22.8 151 14 147 6.4C143.6 0.6 130 1.6 128.6 10C127.2 18.6 137.8 25.6 155 25.8C250 27 352 33.5 466 28.6C548 25 602 18.6 639 16.4"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></path>
</svg>
