---
// The computer's power-on self-test, shown while the room loads; it hands over to the room by itself.
// The page script (layouts/Room.astro) fills the log, dates the screen and dismisses it; this is markup and style.
---

<div class="boot" data-boot data-room-ui>
  <div class="boot-screen">
    <header class="boot-head">
      <div>
        <p class="boot-mark">SAAHIL BIOS</p>
        <p>(C) 2026 Saahil Sanganeriya</p>
      </div>
      <p class="boot-release">Room BIOS rev. 2026</p>
    </header>

    <div class="boot-body" aria-hidden="true">
      <p>Desk, CRT and 8 mm projector found</p>
      <p>Checking RAM : 32768K <span class="ok">OK</span></p>
      <p class="boot-gap" data-boot-status>LOADING RESOURCES</p>
      <ol class="boot-log" data-boot-log></ol>
    </div>

    <div class="boot-thread" role="progressbar" aria-label="Loading the room" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-boot-progress>
      <span data-boot-bar></span>
    </div>

    <footer class="boot-foot" aria-hidden="true">
      <p><span class="boot-skip-key">Press any key to skip the intro</span><span class="boot-skip-tap">Tap to skip</span></p>
      <p><time data-boot-today></time></p>
    </footer>
  </div>
</div>

<style>
  .boot {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    transition:
      opacity 0.35s ease-in,
      transform 0.35s ease-in;
  }

  /* Faint scanlines, the tube's own texture. */
  .boot::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.22) 0 1px, transparent 1px 3px);
  }

  .boot[data-state='gone'] {
    opacity: 0;
    transform: scale(1.06);
    pointer-events: none;
  }

  .boot-screen {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    /* The room's Sound and Pause controls sit over the bottom edge; the footer's lines stay above them. */
    padding-bottom: max(clamp(1.5rem, 5vw, 3.5rem), calc(var(--space-3) + 3rem));
    animation: gate-weave 0.5s steps(1) infinite;
  }

  /* Film gate weave: the frame never sits quite still in the projector. Only here, never over reading text. */
  @keyframes gate-weave {
    0% { transform: translate(0, 0); }
    20% { transform: translate(0.5px, -0.4px); }
    40% { transform: translate(-0.4px, 0.6px); }
    60% { transform: translate(0.3px, 0.2px); }
    80% { transform: translate(-0.5px, -0.3px); }
  }

  /* The projector settles once everything has loaded, just before the room takes over. */
  .boot[data-ready] .boot-screen,
  :global(html.room-paused) .boot-screen {
    animation: none;
  }

  .boot-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4rem;
  }

  .boot-mark {
    color: var(--paper);
    font-size: 1.3125rem;
    letter-spacing: 0.12em;
  }

  .boot-release,
  .boot-body,
  .boot-foot {
    color: var(--dust);
  }

  .boot-body {
    margin-top: 2rem;
  }

  .boot-gap {
    margin-top: 1.5rem;
  }

  .ok,
  .boot-body :global(.pct) {
    color: var(--projector);
  }

  .boot-log {
    margin: 0.5rem 0 0;
    padding-left: 2rem;
    list-style: none;
    white-space: pre;
  }

  /* The loading line is the site's thread: it runs out as the room arrives. */
  .boot-thread {
    position: relative;
    height: 1px;
    margin-top: 1.5rem;
    max-width: 38.5rem;
    background: rgb(168 159 145 / 0.2);
  }

  .boot-thread span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--thread);
    transition: width 0.3s ease-out;
  }

  .boot-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: auto;
  }

  /* A touch screen has no keys to press. */
  .boot-skip-tap {
    display: none;
  }

  @media (pointer: coarse) {
    .boot-skip-key {
      display: none;
    }

    .boot-skip-tap {
      display: inline;
    }
  }
</style>
